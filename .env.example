# =============================================================================
# REPO / GENERAL CONFIGURATION
# =============================================================================
APP_NAME=Blend
DEBUG=false
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://localhost"]
SITE_PASSWORD=
SESSION_EXPIRY_DAYS=7
MAX_DOCUMENTS_PER_SESSION=10

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# Database
# Local SQLite (default for quick local dev without Docker):
DATABASE_URL=sqlite+aiosqlite:///./blend.db
# Local Docker Postgres (uncomment when running `docker compose up`):
# DATABASE_URL=postgresql+asyncpg://blend:blend_local_password@localhost:5432/blend
# Production Neon Serverless Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/blend?sslmode=require

# Google Gemini API & Models
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBED_MODEL=models/gemini-embedding-2
GEMINI_CHAT_MODEL=models/gemini-3.1-flash-lite
EMBEDDING_DIMENSIONS=3072

# Hybrid Search Retrieval & Scoring
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
TOP_K_RETRIEVAL=10
TOP_K_CONTEXT=5
SIMILARITY_THRESHOLD=0.50
RELATIVE_SCORE_THRESHOLD=0.80

# Optional Machine-to-Machine API Key (leave empty to disable in dev)
BLEND_API_KEY=

# Security & Guardrails
ENABLE_RATE_LIMITING=true
RATE_LIMIT_QUERY_PER_MIN=30
RATE_LIMIT_INGEST_PER_MIN=15
RATE_LIMIT_AUTH_PER_MIN=10
ENABLE_PII_SCRUBBING=true
ENABLE_PROMPT_GUARD=true
ENABLE_OUTPUT_SHIELD=true

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Note: Vite only exposes VITE_* variables to the client-side browser bundle.
# Leave empty for local development (Vite dev proxy or Docker Nginx proxies /api -> :8000).
# Set to your deployed backend URL for decoupled production hosting (e.g. Vercel -> Azure).
VITE_API_URL=
