# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── App ────────────────────────────────────────────────────────────
APP_NAME=Blend
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Database ───────────────────────────────────────────────────────
# Local SQLite (default – no extra setup)
DATABASE_URL=sqlite+aiosqlite:///./blend.db

# Production Neon Serverless Postgres (uncomment & fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/blend?sslmode=require

# ── Google Gemini ──────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=models/gemini-2.0-flash
EMBEDDING_DIMENSIONS=768

# ── Hybrid Search Weights ──────────────────────────────────────────
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# ── Retrieval ──────────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_CONTEXT=5

# ── Site Password Protection ──────────────────────────────────────
# Leave empty to disable password protection (dev mode).
# In production, set this to password-protect the site and API.
# SITE_PASSWORD=your-secure-site-password
SITE_PASSWORD=
