# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── App ────────────────────────────────────────────────────────────
APP_NAME=Blend
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Database ───────────────────────────────────────────────────────
# Local SQLite (default – no extra setup)
DATABASE_URL=sqlite+aiosqlite:///./blend.db

# Production Neon Serverless Postgres (uncomment & fill in):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/blend?sslmode=require

# ── Google Gemini Models ───────────────────────────────────────────
# Switch the active chat model here and restart the backend server.
# Supported options include:
#   models/gemini-2.0-flash   (Default – fast, multimodal, recommended)
#   models/gemini-1.5-flash   (Lightweight, high rate-limits)
#   models/gemini-1.5-pro     (Advanced reasoning and complex synthesis)
#   models/gemini-2.5-flash   (Next-gen flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=models/gemini-2.0-flash
EMBEDDING_DIMENSIONS=768

# ── Hybrid Search Weights ──────────────────────────────────────────
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# ── Retrieval ──────────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_CONTEXT=5

# ── Site Password Protection ──────────────────────────────────────
# Leave empty, blank, or null to disable password protection.
# Set a non-empty string to enforce password protection across the site and API.
# SITE_PASSWORD=your-secure-site-password
SITE_PASSWORD=

# ── Session & Document Limits ──────────────────────────────────────
# Number of days before documents and sessions expire (default: 7 = 1 week)
SESSION_EXPIRY_DAYS=7
# Maximum number of documents allowed per session (default: 10)
MAX_DOCUMENTS_PER_SESSION=10
